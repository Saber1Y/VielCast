# Sportmonks Football Data
SPORTMONKS_API_TOKEN=

# Midnight Preprod (the Lace wallet supplies the proof server and indexer URLs)
MIDNIGHT_NETWORK_ID=preprod
MIDNIGHT_DEFAULT_CONTRACT=

# Solana (devnet)
# Use a Helius free RPC in production (api.devnet.solana.com has expired SSL cert)
SOLANA_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_PROGRAM_ID=D254EggCVsZ7jKtJJ29diEv3P4qqjn5APBAvcRwDNsyE

# Admin keypair (base64 of secret key array, or fallback to solana/admin-keypair.json)
# Generate with: node -e "const k=require('@solana/web3.js').Keypair.generate(); console.log(Buffer.from(k.secretKey).toString('base64'))"
ADMIN_KEYPAIR_SECRET=

# Privy Auth
NEXT_PUBLIC_PRIVY_APP_ID=

# Vercel KV (auto-set when KV is provisioned in Vercel dashboard)
KV_URL=
